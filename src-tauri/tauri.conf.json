{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "indigo",
  "version": "0.1.0",
  "identifier": "dev.indigo.widget",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "indigo",
        "width": 344,
        "height": 320,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "resource monitor widget",
    "longDescription": "Ruhiges always-on-top Desktop-Widget für Systemwerte: CPU, RAM, Disk, GPU, Temperaturen, Netz, Leistungsaufnahme und Lüftersteuerung."
  }
}
